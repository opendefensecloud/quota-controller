{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests", "docker:pinDigests"],
  "minimumReleaseAge": "1 day",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "minimumReleaseAge": "0"
  },
  "nix": {
    "enabled": true
  },
  "postUpdateOptions": ["gomodTidy"],
  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "matchDepTypes": ["golang"],
      "rangeStrategy": "bump"
    },
    {
      "matchDatasources": ["docker", "golang-version"],
      "matchPackageNames": ["go", "golang"],
      "groupName": "golang version sync",
      "groupSlug": "go-version"
    },
    {
      "matchPackageNames": [
        "golangci/golangci-lint",
        "github.com/golangci/golangci-lint/v2/cmd/golangci-lint"
      ],
      "groupName": "golangci-lint"
    },
    {
      "matchPackageNames": [
        "sigs.k8s.io/controller-runtime",
        "https://github.com/kubernetes-sigs/controller-runtime"
      ],
      "groupName": "controller-runtime"
    },
    {
      "description": "Hold the k8s stack at what multicluster-runtime and the kcp multicluster-provider support (k8s 0.36 / controller-runtime 0.24); raise together with dependency-controller",
      "matchDatasources": ["go"],
      "matchPackageNames": [
        "k8s.io/api",
        "k8s.io/apiextensions-apiserver",
        "k8s.io/apimachinery",
        "k8s.io/client-go"
      ],
      "allowedVersions": "<0.37.0"
    },
    {
      "description": "controller-runtime and multicluster-runtime 0.25 require k8s 0.37; see the k8s cap above",
      "matchDatasources": ["go"],
      "matchPackageNames": [
        "sigs.k8s.io/controller-runtime",
        "sigs.k8s.io/multicluster-runtime"
      ],
      "allowedVersions": "<0.25.0"
    },
    {
      "description": "controller-gen 0.22 targets k8s 0.37; see the k8s cap above",
      "matchPackageNames": ["sigs.k8s.io/controller-tools/cmd/controller-gen"],
      "allowedVersions": "<0.22.0"
    },
    {
      "description": "setup-envtest branch must match the controller-runtime minor; see the controller-runtime cap above",
      "matchDatasources": ["git-refs"],
      "matchPackageNames": ["https://github.com/kubernetes-sigs/controller-runtime"],
      "allowedVersions": "/^release-0\\.(1[0-9]|2[0-4])$/"
    },
    {
      "description": "git-refs release branches carry no releaseTimestamp, so the repo-wide minimumReleaseAge would hold them pending forever",
      "matchDatasources": ["git-refs"],
      "minimumReleaseAge": "0"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+version: (?<currentValue>\\S+)"
      ],
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)flake\\.nix$/"],
      "matchStrings": [
        "goVersion\\s*=\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "go",
      "datasourceTemplate": "golang-version"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "Makefile"
      ],
      "matchStrings": [
        "DEV_KIT_VERSION := (?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "opendefensecloud/dev-kit",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "tools.lock"
      ],
      "matchStrings": [
        "(?<depName>[^\\s]+) (?<packageName>[^@]+)@(?<currentValue>v[0-9][^\\s]*)"
      ],
      "versioningTemplate": "semver",
      "datasourceTemplate": "go"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "tools.lock"
      ],
      "matchStrings": [
        "(?<depName>setup-envtest) \\S+@(?<currentValue>release-[0-9]+\\.[0-9]+)"
      ],
      "packageNameTemplate": "https://github.com/kubernetes-sigs/controller-runtime",
      "datasourceTemplate": "git-refs",
      "versioningTemplate": "regex:^release-(?<major>[0-9]+)\\.(?<minor>[0-9]+)$"
    }
  ]
}
